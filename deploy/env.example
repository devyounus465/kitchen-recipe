# Copy to .env in the project root on the server:  cp deploy/env.example .env
DOMAIN=example.com
POSTGRES_PASSWORD=change-me-long-random
AUTH_SECRET=change-me-run-openssl-rand-hex-32


# Email (password resets, moderation notices). Uncomment and fill in, e.g. a Hostinger mailbox:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM=Simmerly <no-reply@example.com>

# Private staging (brief §12): require this password (any username) for the whole site and hide it
# from search engines. Remove the line for the public launch, then: docker compose up -d
# STAGING_PASSWORD=choose-a-staging-password
