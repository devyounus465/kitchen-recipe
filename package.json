{
  "name": "simmerly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "local": "tsx scripts/local.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:push": "drizzle-kit push --force && tsx scripts/post-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:push && npm run db:seed",
    "import": "tsx scripts/import.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:security": "node tests/security.mjs",
    "videos:demo": "tsx scripts/make-demo-videos.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "nodemailer": "10.2.1",
    "postgres": "^4.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "overrides": {
    "zod": "$zod",
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=20"
  }
}
